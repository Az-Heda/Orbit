{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for Orbit's windows (main, widget, palette, quick capture)",
  "windows": ["main", "widget", "palette", "capture"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "opener:default",
    "dialog:default"
  ]
}
